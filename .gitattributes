# LF en el repo y en el working copy para todo el texto, independientemente de core.autocrlf.
# Prettier (Arcanist.Web) asume LF; .NET y Visual Studio/Rider trabajan bien con LF.
* text=auto eol=lf

# Scripts de Windows que requieren CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.flac binary
*.ogg binary
*.m4a binary
*.wav binary
*.opus binary
