{
  "openapi": "3.1.1",
  "info": {
    "title": "Arcanist REST API",
    "description": "REST equivalent of the Arcanist GraphQL API (/graphql), without subscriptions. Authenticate with POST /rest/v1/auth/login and send the access token as a Bearer token.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/rest/v1/setup/status": {
      "get": {
        "tags": [
          "Setup"
        ],
        "operationId": "GetSetupStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/setup/database/test": {
      "post": {
        "tags": [
          "Setup"
        ],
        "operationId": "TestSetupDatabase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupDatabase"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseTestResult"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/setup/directories": {
      "get": {
        "tags": [
          "Setup"
        ],
        "operationId": "BrowseSetupDirectories",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryListing"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/setup/complete": {
      "post": {
        "tags": [
          "Setup"
        ],
        "operationId": "CompleteSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rest/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "RefreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/RefreshRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "Logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/RefreshRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rest/v1/auth/reauthenticate": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "Reauthenticate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReauthenticateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/server-info": {
      "get": {
        "tags": [
          "Server"
        ],
        "summary": "Public description of the server. Does not require authentication.",
        "operationId": "ServerInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "The signed-in user.",
        "operationId": "Me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccount"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/me/sessions": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "Devices where the signed-in user is currently signed in.",
        "operationId": "MySessions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/me/sessions/{id}": {
      "delete": {
        "tags": [
          "Me"
        ],
        "summary": "Signs out one of the signed-in user\u0027s devices.",
        "operationId": "RevokeMySession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rest/v1/me/password": {
      "post": {
        "tags": [
          "Me"
        ],
        "summary": "Changes the signed-in user\u0027s password and signs out their other devices.",
        "operationId": "ChangeMyPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeMyPasswordInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rest/v1/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "All users. Requires the MANAGE_USERS permission.",
        "operationId": "Users",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserAccount"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Requires MANAGE_USERS and a recent authentication.",
        "operationId": "CreateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccount"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/users/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "A user by id. Requires the MANAGE_USERS permission.",
        "operationId": "User",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccount"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Requires MANAGE_USERS and a recent authentication.",
        "operationId": "UpdateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccount"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Requires MANAGE_USERS and a recent authentication.",
        "operationId": "DeleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rest/v1/users/{id}/libraries": {
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "Replaces the libraries explicitly granted to a user. Requires MANAGE_USERS and a recent authentication.",
        "operationId": "SetUserLibraries",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetUserLibrariesInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccount"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/users/{id}/password": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Sets a new password and signs the user out everywhere. Requires MANAGE_USERS and a recent authentication.",
        "operationId": "ResetUserPassword",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetUserPasswordInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Capability": {
        "enum": [
          "ULTIMATE_CLOUD_SOURCE",
          "CLOUD_SYNC",
          "THIRD_PARTY_STORAGE",
          "CLOUD_CONNECT"
        ]
      },
      "ChangeMyPasswordInput": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CloudTier": {
        "enum": [
          "NONE",
          "FREE",
          "PAID"
        ]
      },
      "CreateUserInput": {
        "required": [
          "userName",
          "password",
          "displayName",
          "role",
          "permissions",
          "libraryIds"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "permissions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "libraryIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "DatabaseProvider": {
        "enum": [
          "SQLITE",
          "POSTGRES",
          null
        ]
      },
      "DatabaseTestResult": {
        "required": [
          "success",
          "error"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DirectoryEntry": {
        "required": [
          "name",
          "path",
          "isHidden"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "isHidden": {
            "type": "boolean"
          }
        }
      },
      "DirectoryListing": {
        "required": [
          "path",
          "parent",
          "directories"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "null",
              "string"
            ]
          },
          "parent": {
            "type": [
              "null",
              "string"
            ]
          },
          "directories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DirectoryEntry"
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password",
          "deviceName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "deviceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "useCookie": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Permission": {
        "enum": [
          "MANAGE_LIBRARIES",
          "MANAGE_USERS",
          "MANAGE_SETTINGS",
          "RUN_SCANS",
          "DOWNLOAD",
          "VIEW_ALL_STATS"
        ]
      },
      "ReauthenticateRequest": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ResetUserPasswordInput": {
        "required": [
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string"
          }
        }
      },
      "ServerInfo": {
        "required": [
          "name",
          "version",
          "apiVersion",
          "sourceUrl",
          "setupCompleted",
          "capabilities",
          "cloudTier"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "apiVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sourceUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "setupCompleted": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          },
          "cloudTier": {
            "$ref": "#/components/schemas/CloudTier"
          }
        }
      },
      "Session": {
        "required": [
          "id",
          "deviceName",
          "userAgent",
          "ipAddress",
          "createdAt",
          "lastSeenAt",
          "expiresAt",
          "isCurrent"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deviceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "userAgent": {
            "type": [
              "null",
              "string"
            ]
          },
          "ipAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean"
          }
        }
      },
      "SetupAdmin": {
        "required": [
          "userName",
          "password",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SetupDatabase": {
        "required": [
          "provider",
          "connectionString"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DatabaseProvider"
              }
            ]
          },
          "connectionString": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SetupDatabaseStatus": {
        "required": [
          "configured",
          "lockedByEnvironment",
          "provider",
          "defaultSqlitePath"
        ],
        "type": "object",
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "lockedByEnvironment": {
            "type": "boolean"
          },
          "provider": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DatabaseProvider"
              }
            ]
          },
          "defaultSqlitePath": {
            "type": "string"
          }
        }
      },
      "SetupLibrary": {
        "required": [
          "name",
          "folders"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "folders": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "visibleToAll": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "SetupRequest": {
        "required": [
          "database",
          "admin",
          "libraries",
          "shareAnonymousStatistics",
          "language"
        ],
        "type": "object",
        "properties": {
          "database": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SetupDatabase"
              }
            ]
          },
          "admin": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SetupAdmin"
              }
            ]
          },
          "libraries": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/SetupLibrary"
            }
          },
          "shareAnonymousStatistics": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "language": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SetupStatus": {
        "required": [
          "completed",
          "requiresCode",
          "database",
          "dataDirectory"
        ],
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "requiresCode": {
            "type": "boolean"
          },
          "database": {
            "$ref": "#/components/schemas/SetupDatabaseStatus"
          },
          "dataDirectory": {
            "type": "string"
          }
        }
      },
      "SetUserLibrariesInput": {
        "required": [
          "libraryIds"
        ],
        "type": "object",
        "properties": {
          "libraryIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "TokenResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "sessionExpiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserAccount"
          }
        }
      },
      "UpdateUserInput": {
        "required": [
          "displayName",
          "role",
          "permissions",
          "isDisabled"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "permissions": {
            "type": [
              "null",
              "array"
            ],
