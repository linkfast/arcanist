# Copy to .env next to the Compose file and adjust.

# The folder of your music on the host (required).
MUSIC_DIR=/srv/music

# The port Arcanist answers on, on the host.
ARCANIST_PORT=8484

# The image's tag: "preview" follows the newest release (there are only pre-releases for now), "latest" the newest
# stable one, or a version such as 0.1.0-alpha.1 to stay on it.
ARCANIST_TAG=preview

# Your time zone (for logs and scheduled tasks), e.g. Europe/Madrid or America/Lima.
TZ=UTC

# Only for compose.postgres.yaml: the password of the database (any long random text).
POSTGRES_PASSWORD=

# Optional folders, if you uncomment them in the Compose file.
# DROP_DIR=/srv/incoming
# BACKUP_DIR=/srv/backups
