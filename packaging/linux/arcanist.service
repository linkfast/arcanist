# systemd unit for an Arcanist tarball extracted to /opt/arcanist. See packaging/linux/README.md.
[Unit]
Description=Arcanist music server
Documentation=https://github.com/linkfast/arcanist
Wants=network-online.target
After=network-online.target

[Service]
# The server reports readiness to systemd itself (Microsoft.Extensions.Hosting.Systemd).
Type=notify
ExecStart=/opt/arcanist/arcanist
WorkingDirectory=/opt/arcanist
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# A throwaway system user owns /var/lib/arcanist (the data directory, passed as $STATE_DIRECTORY).
# Music folders must be readable by others, or add the group that can read them:
#   SupplementaryGroups=music
DynamicUser=yes
StateDirectory=arcanist
StateDirectoryMode=0750

# Hardening: the server only writes its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# Server audio (off by default) plays through the sound card: it needs PrivateDevices=no and SupplementaryGroups=audio.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
