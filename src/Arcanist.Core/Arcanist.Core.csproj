<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The executable users and service managers see: arcanist(.exe). -->
    <AssemblyName>arcanist</AssemblyName>
    <RootNamespace>Arcanist.Core</RootNamespace>
    <!-- Function pointers and spans over native memory in Analysis/NativeAudio.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arcanist.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arcanist.Extensibility\Arcanist.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL" Version="8.8.5" />
    <PackageReference Include="GraphQL.Server.Transports.AspNetCore" Version="8.3.3" />
    <PackageReference Include="GraphQL.SystemTextJson" Version="8.8.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="z440.atl.core" Version="7.18.0" />
  </ItemGroup>

  <!--
    `dotnet publish -p:IncludeAdminPanel=true` also builds the Angular admin panel and ships it as wwwroot/admin.
    Off by default because it needs Node.js (see mise.toml); the Dockerfile builds the panel in its own stage.
  -->
  <PropertyGroup>
    <AdminPanelDirectory>$(MSBuildThisFileDirectory)../Arcanist.Web/</AdminPanelDirectory>
  </PropertyGroup>

  <Target Name="PublishAdminPanel" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(IncludeAdminPanel)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(AdminPanelDirectory)" />
    <Exec Command="npm run build" WorkingDirectory="$(AdminPanelDirectory)" />
    <ItemGroup>
      <AdminPanelFile Include="$(AdminPanelDirectory)dist/arcanist-web/browser/**/*" />
      <ResolvedFileToPublish Include="@(AdminPanelFile)" RelativePath="wwwroot/admin/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Native audio analysis (native/arcanist-audio, Rust), shipped next to the server as arcanist_audio.dll,
    libarcanist_audio.so or libarcanist_audio.dylib. Builds for this machine's platform run `cargo build` when
    Rust is installed (incrementally); builds for other platforms use the library that packaging/native built
    into artifacts/native/<rid>/. Without either, the server runs without audio analysis.
  -->
  <PropertyGroup>
    <NativeAudioCrate>$(MSBuildThisFileDirectory)../../native/arcanist-audio/</NativeAudioCrate>
    <NativeAudioRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NativeAudioRid>
    <NativeAudioRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</NativeAudioRid>
    <NativeAudioDir>$(MSBuildThisFileDirectory)../../artifacts/native/$(NativeAudioRid)/</NativeAudioDir>
    <NativeAudioFile Condition="$(NativeAudioRid.StartsWith('win'))">arcanist_audio.dll</NativeAudioFile>
    <NativeAudioFile Condition="$(NativeAudioRid.StartsWith('osx'))">libarcanist_audio.dylib</NativeAudioFile>
    <NativeAudioFile Condition="'$(NativeAudioFile)' == ''">libarcanist_audio.so</NativeAudioFile>
  </PropertyGroup>

  <ItemGroup>
    <NativeAudioSource Include="$(NativeAudioCrate)src/**/*.rs;$(NativeAudioCrate)Cargo.toml;$(NativeAudioCrate)Cargo.lock" />
  </ItemGroup>

  <Target Name="BuildNativeAudio" Condition="'$(NativeAudioRid)' == '$(NETCoreSdkRuntimeIdentifier)' And '$(SkipNativeAudioBuild)' != 'true'" Inputs="@(NativeAudioSource)" Outputs="$(NativeAudioDir)$(NativeAudioFile)">
    <Exec Command="cargo --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="CargoExitCode" />
    </Exec>
    <Warning Condition="'$(CargoExitCode)' != '0' And !Exists('$(NativeAudioDir)$(NativeAudioFile)')" Text="Rust (cargo) is not installed, so the native audio library was not built: audio analysis will be unavailable." />
    <Exec Condition="'$(CargoExitCode)' == '0'" Command="cargo build --release --manifest-path &quot;$(NativeAudioCrate)Cargo.toml&quot;" />
    <Copy Condition="'$(CargoExitCode)' == '0'" SourceFiles="$(NativeAudioCrate)target/release/$(NativeAudioFile)" DestinationFolder="$(NativeAudioDir)" />
  </Target>

  <Target Name="IncludeNativeAudio" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildNativeAudio">
    <ItemGroup Condition="Exists('$(NativeAudioDir)$(NativeAudioFile)')">
      <None Include="$(NativeAudioDir)$(NativeAudioFile)" Link="$(NativeAudioFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
