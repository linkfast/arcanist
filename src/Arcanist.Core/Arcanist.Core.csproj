<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The executable users and service managers see: arcanist(.exe). -->
    <AssemblyName>arcanist</AssemblyName>
    <RootNamespace>Arcanist.Core</RootNamespace>
    <!-- Function pointers and spans over native memory in Analysis/NativeAudio.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arcanist.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arcanist.Extensibility\Arcanist.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL" Version="8.8.5" />
    <PackageReference Include="GraphQL.Server.Transports.AspNetCore" Version="8.3.3" />
    <PackageReference Include="GraphQL.SystemTextJson" Version="8.8.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="z440.atl.core" Version="7.18.0" />
  </ItemGroup>

  <!--
    `dotnet publish -p:IncludeAdminPanel=true` also builds the Angular admin panel and ships it as wwwroot/admin.
    Off by default because it needs Node.js (see mise.toml); the Dockerfile builds the panel in its own stage.
  -->
  <PropertyGroup>
    <AdminPanelDirectory>$(MSBuildThisFileDirectory)../Arcanist.Web/</AdminPanelDirectory>
  </PropertyGroup>

  <Target Name="PublishAdminPanel" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(IncludeAdminPanel)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(AdminPanelDirectory)" />
    <Exec Command="npm run build" WorkingDirectory="$(AdminPanelDirectory)" />
    <ItemGroup>
      <AdminPanelFile Include="$(AdminPanelDirectory)dist/arcanist-web/browser/**/*" />
      <ResolvedFileToPublish Include="@(AdminPanelFile)" RelativePath="wwwroot/admin/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Native libraries in Rust, shipped next to the server: audio analysis (native/arcanist-audio) and the P2P network
    (native/arcanist-p2p), as <name>.dll, lib<name>.so or lib<name>.dylib. Builds for this machine's platform run
    `cargo build` when Rust is installed (incrementally); builds for other platforms use the libraries that
    packaging/native built into artifacts/native/<rid>/. Without them, the server runs without that feature.
    SkipNativeBuild (or the older SkipNativeAudioBuild) skips cargo.
  -->
  <PropertyGroup>
    <NativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NativeRid>
    <NativeRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</NativeRid>
    <NativeDir>$(MSBuildThisFileDirectory)../../artifacts/native/$(NativeRid)/</NativeDir>
    <NativeLibraryPrefix Condition="!$(NativeRid.StartsWith('win'))">lib</NativeLibraryPrefix>
    <NativeLibraryExtension Condition="$(NativeRid.StartsWith('win'))">.dll</NativeLibraryExtension>
    <NativeLibraryExtension Condition="$(NativeRid.StartsWith('osx'))">.dylib</NativeLibraryExtension>
    <NativeLibraryExtension Condition="'$(NativeLibraryExtension)' == ''">.so</NativeLibraryExtension>
    <SkipNativeBuild Condition="'$(SkipNativeAudioBuild)' == 'true'">true</SkipNativeBuild>
  </PropertyGroup>

  <ItemGroup>
    <NativeCrate Include="$(MSBuildThisFileDirectory)../../native/arcanist-audio/" Library="$(NativeLibraryPrefix)arcanist_audio$(NativeLibraryExtension)" Feature="audio analysis" />
    <NativeCrate Include="$(MSBuildThisFileDirectory)../../native/arcanist-p2p/" Library="$(NativeLibraryPrefix)arcanist_p2p$(NativeLibraryExtension)" Feature="the P2P network" />
  </ItemGroup>

  <Target Name="BuildNative" Condition="'$(NativeRid)' == '$(NETCoreSdkRuntimeIdentifier)' And '$(SkipNativeBuild)' != 'true'" Inputs="%(NativeCrate.Identity)src/lib.rs;%(NativeCrate.Identity)Cargo.toml;%(NativeCrate.Identity)Cargo.lock;@(NativeSource)" Outputs="$(NativeDir)%(NativeCrate.Library)">
    <ItemGroup>
      <NativeSource Include="%(NativeCrate.Identity)src/**/*.rs" />
    </ItemGroup>
    <Exec Command="cargo --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="CargoExitCode" />
    </Exec>
    <Warning Condition="'$(CargoExitCode)' != '0' And !Exists('$(NativeDir)%(NativeCrate.Library)')" Text="Rust (cargo) is not installed, so %(NativeCrate.Library) was not built: %(NativeCrate.Feature) will be unavailable." />
    <Exec Condition="'$(CargoExitCode)' == '0'" Command="cargo build --release --manifest-path &quot;%(NativeCrate.Identity)Cargo.toml&quot;" />
    <Copy Condition="'$(CargoExitCode)' == '0'" SourceFiles="%(NativeCrate.Identity)target/release/%(NativeCrate.Library)" DestinationFolder="$(NativeDir)" />
  </Target>

  <Target Name="IncludeNative" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildNative">
    <ItemGroup>
      <None Include="$(NativeDir)%(NativeCrate.Library)" Condition="Exists('$(NativeDir)%(NativeCrate.Library)')" Link="%(NativeCrate.Library)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
