<Project Sdk="Microsoft.NET.Sdk">

  <!-- The contract between the server and its extensions. Extensions reference it (and the server for its services). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Arcanist.Extensibility</PackageId>
    <Description>SDK for Arcanist server extensions.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
