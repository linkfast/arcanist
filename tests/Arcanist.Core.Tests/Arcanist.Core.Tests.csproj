<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arcanist.Core\Arcanist.Core.csproj" />
    <!-- Built, but not referenced: the tests install it as a package, so it loads like a third-party extension. -->
    <ProjectReference Include="..\Arcanist.TestExtension\Arcanist.TestExtension.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyTestExtension" AfterTargets="Build">
    <MSBuild Projects="..\Arcanist.TestExtension\Arcanist.TestExtension.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="TestExtensionAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(TestExtensionAssembly)" DestinationFolder="$(OutDir)test-extension" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
